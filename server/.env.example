# YouTube Data API v3 keys (Google Cloud Console -> enable "YouTube Data API v3" -> Credentials)
# Either a single key or multiple comma-separated keys work.
YOUTUBE_API_KEYS=your_youtube_api_key_1,your_youtube_api_key_2
# Legacy fallback:
# YOUTUBE_API_KEY=your_youtube_api_key
PORT=5000
CLIENT_ORIGIN=http://localhost:5174
# No Anthropic API key is required. The backend uses the built-in JavaScript parser.
